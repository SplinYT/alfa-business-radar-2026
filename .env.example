APP_PASSWORD=demo-radar-2026
# Set /private to import participant data on first start; default uses synthetic demo.
DATA_DIR=/app/data/demo
LLM_ENABLED=0
LLM_BASE_URL=
LLM_API_KEY=
# Allowed display name from Appendix 3, e.g. Qwen3.6 35B A3B
LLM_MODEL=
# Actual model identifier issued by organizers (do not guess it).
LLM_MODEL_ID=
COOKIE_SECURE=0
# Optional comma-separated company IDs this demo account may read.
DEMO_COMPANIES=
# Conservative reservation: UTF-8 JSON character count + output cap; not a ruble meter.
LLM_DAILY_TOKEN_LIMIT=30000
MAX_LLM_CALLS_PER_RUN=2
